# Database Configurations
# Replace with your managed PostgreSQL URL (e.g. Supabase, Railway, Render)
DATABASE_URL="postgresql://username:password@hostname:5432/database_name?schema=public"

# NextAuth Configuration
# Run `openssl rand -base64 33` to generate a secure secret key
AUTH_SECRET="your-secure-next-auth-secret-key"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:3000"

# Gmail SMTP Email Delivery Configurations
GMAIL_USER="your-email@gmail.com"
GMAIL_PASS="your-gmail-app-password" # Obtain from Google Account Security > App Passwords

# Google OAuth Credentials
# Obtain from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Public App URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Upstash Redis Configuration (Required for Rate Limiting)
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-rest-token-here"

# Custom SMTP/Resend Configuration (Preferred for Production Mail Delivery)
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_USER="resend"
SMTP_PASSWORD="your-smtp-password-or-resend-api-key"
SMTP_FROM="Linkle <noreply@yourdomain.com>"

# Stripe Integration Configurations
STRIPE_SECRET_KEY="sk_test_51P..."
STRIPE_WEBHOOK_SECRET="whsec_..."



